# Dependencies
node_modules/
api/.venv/
__pycache__/
*.pyc

# Build output. Two kinds, and they no longer share a folder:
#   ui/    the Vite bundle (vite.config.ts says why it is not dist/)
#   dist/  built installers, collected by desktop/scripts/collect-installer.ps1
#          — the same place every app in this suite collects to
ui/
dist/
.vite/

# ...but the desktop shell's dist/ is SOURCE, not output: it holds the
# startup page Tauri loads before the backend is up. The bare `dist/`
# rule above matches at any depth and would silently drop it.
!desktop/dist/
!desktop/dist/**

# Desktop shell build output: the vendored Python runtime and staged app
# (rebuilt by fetch-python.ps1 / stage-app.ps1), Tauri's generated
# schemas, and the Rust target dir.
desktop/node_modules/
desktop/src-tauri/vendor/
desktop/src-tauri/gen/
desktop/src-tauri/target/


# Editor/OS noise
.DS_Store
Thumbs.db
*.local

# Machine-specific LLM provider settings - may name private models or
# endpoints. Keys live in environment variables, not here.
api/settings.json

# Persistent clone of the Pentaho-Courses distribution repo, used by
# the Publish feature.
api/.publish-cache/
api/.pytest_cache/
