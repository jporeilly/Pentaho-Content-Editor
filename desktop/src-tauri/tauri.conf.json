{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Pentaho Content Editor",
  "version": "1.11.0",
  "identifier": "com.pentaho.content-editor",
  "build": {
    "beforeBuildCommand": "npm run fetch:python && npm run fetch:runtimes && npm run stage:app",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Pentaho Content Editor",
        "width": 1500,
        "height": 950,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/python": "python",
      "vendor/app": "app",
      "vendor/tools": "tools",
      "../scripts/find-courses.ps1": "provisioning/find-courses.ps1",
      "../scripts/install-ollama.ps1": "provisioning/install-ollama.ps1"
    },
    "category": "DeveloperTool",
    "shortDescription": "Visual authoring for Pentaho Content Manager courses",
    "longDescription": "Edits the lab guides in a Pentaho Content Manager checkout with a live preview drawn by the learner app's own renderer: an insert-block toolbar over the course conventions, a structure tree, Verify and an AI review marked in the source, and one-click publishing to the distribution repository the workshop VMs sync from.",
    "publisher": "Pentaho Presales Engineering",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "template": "nsis/installer.nsi",
        "languages": [
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/sign.ps1 %1"
    },
    "licenseFile": "../../LICENSE.txt"
  },
  "plugins": {}
}
